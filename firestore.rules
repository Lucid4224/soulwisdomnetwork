rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function unchanged(key) {
      return request.resource.data.get(key, null) == resource.data.get(key, null);
    }

    // Profiles: any signed-in user can read; only you can write yours. `role` gates the
    // admin area, so a new profile must start as 'user' and nobody can change their own.
    // Roles are changed only through the Admin SDK or the Firebase console. The `uid` field
    // must be your own, because profile pages look people up by it. No email: every member
    // can read profiles, so admins get emails from Firebase Auth (lib/server/members.ts).
    // An old profile may still have one until an admin opens /admin; it can only be removed.
    // After sign-up a member may change only their name and bio, and remove their photo
    // (app/profile/edit): a ban (`banned`, set by an admin through the server) stays put.
    match /users/{userId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.get('role', 'user') == 'user'
                    && request.resource.data.get('uid', userId) == userId
                    && !('email' in request.resource.data)
                    && !('banned' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == userId
                    && onlyChanges(['displayName', 'bio', 'photoURL', 'email'])
                    && (!('email' in request.resource.data) || unchanged('email'))
                    && (unchanged('photoURL') || request.resource.data.photoURL == null)
                    && (unchanged('displayName') || (request.resource.data.displayName is string
                        && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 40))
                    && (unchanged('bio') || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500));
      allow delete: if false;
    }

    // The community feed (docs/specs/016-community-feed.md): posts, comments and their votes
    // are read and written only by the server routes in app/api/community, which check
    // sign-in, email confirmation, bans, App Check and rate limits. Nothing from the browser.
    match /posts/{postId}/{document=**} {
      allow read, write: if false;
    }
    match /comments/{commentId}/{document=**} {
      allow read, write: if false;
    }

    // Direct messages: participants only. A conversation is between exactly two people and
    // its ID is their two uids, sorted and joined with "_" (lib/firebase/messaging.ts), so
    // nobody can open a conversation in someone else's name or add themselves to one. After
    // that, sending a message may only update the last-message fields.
    match /conversations/{convId} {
      // A conversation that does not exist yet reads as empty, so the app can check before creating it.
      allow read:   if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants[0] != request.resource.data.participants[1]
                    && (convId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
                        || convId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0]);
      allow update: if signedIn() && request.auth.uid in resource.data.participants
                    && onlyChanges(['lastMessage', 'lastMessageTimestamp', 'updatedAt']);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      // A banned member's account is disabled, but a sign-in token lasts up to an hour.
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false)
                    && request.auth.uid in
                      get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
      allow update, delete: if false;
    }

    // Podcast pipeline state, written by agent/src/podcast/ingest.ts via the Admin SDK.
    // No client access until the review page exists; it will read through the server.
    match /episodes/{episodeId} {
      allow read, write: if false;
    }

    // Usage reports (docs/specs/014-usage.md), written by the podcast jobs and read by the
    // Usage page through the server. Unmatched paths are denied anyway; this says so.
    match /usage_reports/{reportId} {
      allow read, write: if false;
    }

    // Each member's recent posts and comments, for the hourly limits (lib/server/community.ts).
    match /community_limits/{userId} {
      allow read, write: if false;
    }
  }
}
