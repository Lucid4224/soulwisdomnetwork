rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Profiles: any signed-in user can read; only you can write yours. `role` gates the
    // admin area, so a new profile must start as 'user' and nobody can change their own.
    // Roles are changed only through the Admin SDK or the Firebase console.
    match /users/{userId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.get('role', 'user') == 'user';
      allow update: if signedIn() && request.auth.uid == userId
                    && request.resource.data.get('role', null) == resource.data.get('role', null);
      allow delete: if false;
    }

    // Posts: public to read. Author creates and edits their own. Any signed-in
    // user may bump ONLY the counters, because the like and comment buttons do.
    match /posts/{postId} {
      allow read:   if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && (
                      resource.data.authorId == request.auth.uid
                      || onlyChanges(['commentCount', 'likesCount'])
                    );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /comments/{commentId} {
      allow read:           if true;
      allow create:         if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Direct messages: participants only.
    match /conversations/{convId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create:       if signedIn() && request.auth.uid in request.resource.data.participants;
      allow delete:       if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      allow create:         if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // Written by the scout agent via the Admin SDK, which bypasses these rules.
    // No client writes are needed.
    match /feed_items/{itemId} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /channels/{channelId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // Podcast pipeline state, written by agent/src/podcast/ingest.ts via the Admin SDK.
    // No client access until the review page exists; it will read through the server.
    match /episodes/{episodeId} {
      allow read, write: if false;
    }

    // Usage reports (docs/specs/014-usage.md), written by the podcast jobs and read by the
    // Usage page through the server. Unmatched paths are denied anyway; this says so.
    match /usage_reports/{reportId} {
      allow read, write: if false;
    }
  }
}
